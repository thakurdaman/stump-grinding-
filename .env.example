# Database (SQLite for local/zero-friction, or postgresql://... for production)
DATABASE_URL="file:./dev.db"

# Public App URL (used for webhooks and download links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo Mode: Set to "true" to test the checkout & file delivery flow end-to-end without payment credentials
DEMO_MODE="true"

# Active Payment Provider: "paypal" (active), "lemonsqueezy", "stripe", "razorpay", or "demo"
PAYMENT_PROVIDER="paypal"

# PDF Licensing & Watermarking Configuration
# STAMP_PDF: "true" to stamp buyer email, orderId, and date onto every PDF page on download (default: true)
STAMP_PDF="true"
# STAMP_DIAGONAL: "true" to add a subtle 7% opacity diagonal watermark across the middle of every page (default: true)
STAMP_DIAGONAL="true"
# STAMP_CACHE: "true" to cache stamped PDFs in /private-files/stamped/ keyed by orderId for instant re-downloads (default: true)
STAMP_CACHE="true"
# STAMP_FAIL_MODE: "block" to return a 500 error if stamping fails; "fallback" to serve unstamped original (default: block)
STAMP_FAIL_MODE="block"

# Support / Contact recipient email
SUPPORT_EMAIL="support@stumpgrindingplaybook.com"

# Admin API Key (for exporting captured email leads)
ADMIN_SECRET_KEY="stump-admin-secret-change-in-production"

# Transactional Email (Resend) - leave blank in demo/local dev to log emails to console
RESEND_API_KEY=""

# Lemon Squeezy (Merchant of Record - best for individuals in India selling to US customers)
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""
LEMONSQUEEZY_VARIANT_PLAYBOOK=""
LEMONSQUEEZY_VARIANT_CALCULATOR=""
LEMONSQUEEZY_VARIANT_FULL_KIT=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# PayPal
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_MODE="sandbox"

# Razorpay (optional for INR transactions)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Privacy-friendly Analytics (optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_GA_ID=""
